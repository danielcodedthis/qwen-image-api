FROM rocm/pytorch:latest

WORKDIR /app

# Turbo ships its 8-step sampling schedule inside the checkpoint. Reading it needs
# a recent diffusers (source build, newer than a tagged release) and
# transformers >= 5.17. This image is built separately from the main one, so
# updating it never touches the working qwen-image-api image.
# Pin a commit with:  docker compose build --build-arg DIFFUSERS_REF=<sha> qwen-image-turbo-api
ARG DIFFUSERS_REF=main

RUN pip install --no-cache-dir \
    "git+https://github.com/huggingface/diffusers@${DIFFUSERS_REF}" \
    "transformers>=5.17.0" \
    accelerate \
    pillow \
    torchao

# API server: FastAPI, uvicorn, Pillow, PyYAML, python-multipart, MCP SDK.
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# The code is copied in at build time: editing server/ needs `docker compose up -d --build`.
COPY server/ /app/server/

RUN chmod -R a+rX /app

EXPOSE 8000

CMD ["python3", "-m", "server"]
