# Model weights — mounted as a volume at runtime, never needed in the build context
models/

# MIOpen cache — also volume-mounted, not baked into the image
cache/

# Git metadata — irrelevant to the image
.git/
.gitignore

# Python artifacts
__pycache__/
*.pyc

# Local test outputs
*.png
response.json
output/

# Docs, tests, tools, skills and the UI are not needed inside the API image
*.md
docs/
tests/
tools/
skills/
web/

# Environment variables
.env